# =========================================================
# Plantilla de variables de entorno. Copiar a .env:
#   cp .env.example .env
# =========================================================

# ---------- PostgreSQL (superusuario de la instancia) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secret

# Base transaccional (dueño: service-java)
TX_DB=reservas_tx
TX_USER=tx_user
TX_PASSWORD=tx_secret

# Base analítica (dueño: service-python)
ANALYTICS_DB=reservas_analytics
ANALYTICS_USER=analytics_user
ANALYTICS_PASSWORD=analytics_secret

# ---------- Redis ----------
REDIS_PASSWORD=redis_secret

# ---------- Concurrencia ----------
# Tiempo de bloqueo temporal de un asiento (segundos)
LOCK_TTL_SECONDS=300

# ---------- Puertos internos (red backend-net, no expuestos) ----------
JAVA_PORT=8080
GO_PORT=8081
PYTHON_PORT=8000

# ---------- Puertos publicados al host ----------
GATEWAY_PORT=4000
FRONTEND_PORT=3000

# ---------- URLs públicas que usa el navegador ----------
# Orígenes permitidos por el gateway (separados por coma)
CORS_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/api
PUBLIC_WS_URL=http://localhost:4000
