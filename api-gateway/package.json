{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "API Gateway: enrutamiento HTTP, orquestación de compras y WebSockets en tiempo real",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "ws-test": "node scripts/ws-test.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "axios": "1.7.7",
    "cors": "2.8.5",
    "express": "4.21.1",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "morgan": "1.10.0",
    "socket.io": "4.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "socket.io-client": "4.8.1"
  }
}
